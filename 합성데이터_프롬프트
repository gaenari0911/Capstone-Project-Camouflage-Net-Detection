13. sample_candidate_positions(bg_h, bg_w, obj_h, obj_w, num_candidates)
14. extract_background_patch(background, x, y, obj_w, obj_h)
15. compute_patch_texture_score(patch)
16. compute_object_background_match_score(object_bgr, object_mask, patch_bgr, y_ratio, mode)
17. select_best_object_and_position(background, object_candidates, mode)
18. apply_tone_matching(object_bgr, object_mask, patch_bgr, mode)
19. build_alpha_from_mask(mask, mode)
20. blend_object(background, object_bgr, alpha, x, y)
21. build_transformed_binary_mask(bg_h, bg_w, object_mask, x, y)
22. mask_to_polygon_lines(mask, class_id)
23. save_polygon_txt(txt_path, polygon_lines)
24. save_result_image(path, image)
25. save_result_mask(path, mask)
26. main()

